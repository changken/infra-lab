compartment_id = "ocid1.compartment.oc1..xxxx" # envs/oci-governance output
subnet_id      = "ocid1.subnet.oc1.ap-singapore-1.xxxx" # envs/oci-vcn output
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
image_id       = "ocid1.image.oc1.ap-singapore-1.xxxx"

# 可選（預設為 import 現況）：
