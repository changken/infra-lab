subscription_id = "00000000-0000-0000-0000-000000000000"

project     = "zeabur"
environment = "dev"
location    = "japaneast"

vnet_cidr = "172.28.0.0/16"
subnets = {
  subnet1 = "172.28.1.0/24"
  subnet2 = "172.28.2.0/24"
}
vm_subnet_key = "subnet1"

# 全開。建議改成你自己的 IP，例如 "203.0.113.10/32"
allowed_source_prefix_ssh = "*"
allowed_source_prefix = "*"

vm_size         = "Standard_B1ms" # 1 vCPU / 2 GiB；實際跑服務建議 Standard_B2s
admin_username  = "azureuser"
os_disk_size_gb = 64
os_disk_type    = "StandardSSD_LRS"

tags = {
  owner = "ken"
}
