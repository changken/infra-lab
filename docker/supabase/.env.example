####################################
# Supabase Self-Hosted 環境設定範例
# 複製此檔案為 .env，並填入實際值
####################################

# --- 密鑰 (必填，請務必替換) ---
# JWT Secret: 至少 32 字元的隨機字串
# 產生指令: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-change-me

# Anon Key 與 Service Role Key 需使用 JWT_SECRET 簽署的 JWT
# 可使用 https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys 工具產生
ANON_KEY=.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxOTk3MzQ1MjAwfQ.dc_X5iR_VP_qroQgNRg3NOdq_Q_t3aSY34dGR8sLzFE
SERVICE_ROLE_KEY=eyJhbGciOieyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9JIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjQxNzY5MjAwLCJleHAiOjE5OTczNDUyMDB9.4t_6vN3NQKP2Iy2LiKcbvEgVOOWV0nDM7s_6ixr3Yk

# --- 資料庫設定 ---
POSTGRES_PASSWORD=Change_Me_StrongP@ssw0rd!
POSTGRES_DB=postgres
POSTGRES_PORT=15433   # Host Port，避免與 postgresql-db(15432) 衝突

# --- 對外連接埠 ---
KONG_HTTP_PORT=18000   # API Gateway (主要存取點)
KONG_HTTPS_PORT=18443
STUDIO_PORT=13000      # Supabase Studio 管理介面

# --- 網站 URL (供 Auth 重導向使用) ---
SITE_URL=http://localhost:13000
API_EXTERNAL_URL=http://localhost:18000

# --- 儲存 ---
STORAGE_BACKEND=file   # 本地開發使用 file，生產環境可換 s3

# --- Dashboard 認證 ---
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=Change_Me_DashP@ssw0rd!

# --- SMTP (選填，用於 Auth 寄信功能) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase Lab

# --- 時區 ---
TZ=Asia/Taipei
